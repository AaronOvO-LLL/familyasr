# 腾讯云实时语音识别 凭据占位文件
# 复制为 .env 并通过安全渠道填入真实值。
# .env 已被 .gitignore 忽略：不得提交仓库、不得发到聊天或截图。
# 只在后端/测试工具进程环境中使用，绝不进入浏览器端。

ASR_APPID=
ASR_SECRET_ID=
ASR_SECRET_KEY=

# ---- 应用配置（M1）----
# 识别提供方：mock（模拟，不访问云、不产生费用）| tencent（真实腾讯云链路）
ASR_PROVIDER=tencent
# 腾讯云实时 ASR V2 引擎模型
ASR_ENGINE_MODEL_TYPE=16k_zh_en_2.0

# 家庭访问码：页面与 WebSocket 鉴权用，必填（建议 12 位以上随机串）
ACCESS_TOKEN=

# 监听地址。开发默认仅回环；局域网 Pad 试用改为 0.0.0.0（见 M2 文档）
HOST=127.0.0.1
PORT=7020

# 局域网 HTTPS（可选）：mkcert 证书与私钥路径（见 docs/implementation/M2-局域网配置与试用说明.md）
# 留空 = 纯 HTTP（仅限 localhost 开发；Android Pad 采音必须 HTTPS）
TLS_CERT_FILE=
TLS_KEY_FILE=

# 用量限制（秒）。开发默认每日 30 分钟；单次默认 120 分钟
DAILY_LIMIT_SECONDS=1800
SESSION_LIMIT_SECONDS=7200
