[Unit]
Description=家语字幕屏 familyasr（实时字幕 Web 服务）
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/familyasr
# 配置与密钥由应用从 /srv/familyasr/.env 读取（不入库、不进 unit）
ExecStart=/srv/familyasr/.venv/bin/python scripts/run_server.py
Restart=on-failure
RestartSec=3
# 最小权限加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
